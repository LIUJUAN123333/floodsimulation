# ============================================================
# Flood Simulation System - Git Ignore Rules
# Keep frontend source + Python backend source tracked;
# ignore runtime artifacts, generated data, and local tools.
# ============================================================

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Frontend build / dependencies
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / local config
.env
.env.*
!.env.example
*.local

# Python runtime / cache
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
backend/uploads/
backend/outputs/
backend/logs/
backend/runtime/

# Temporary / debug artifacts
.playwright-cli/
output/
outputs/
screenshots/
videos/
trace/
traces/
playwright-report/
test-results/
.codex-backups/
*.tmp
*.temp
*.bak
*.backup
~$*

# Large showcase / test data
# These are datasets or generated outputs, not source code.
data_showcase/
测试数据/
public/data/showcase/*/files/
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.asc
*.tif
*.tiff
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.dat
*.mesh.json
**/mesh/
Flood*.json
Flood*.txt
flood_txt.zip
flood_json.zip

# C++ backend / Visual Studio artifacts
FloodTest_parallel/
FloodTest_parallel/.vs/
FloodTest_parallel/ipch/
FloodTest_parallel/%SystemDrive%/
FloodTest_parallel/**/Debug/
FloodTest_parallel/**/Release/
FloodTest_parallel/**/x64/Debug/
FloodTest_parallel/**/x64/Release/
FloodTest_parallel/**/uploads/
FloodTest_parallel/**/Data_dx_5m/
FloodTest_parallel/Data/
FloodTest_parallel/Data_*/
FloodTest_parallel/testData/
FloodTest_parallel/lwl_new_*/
FloodTest_parallel/FloodTest/Ffile/
FloodTest_parallel/FloodTest/Cellularautomata*/
FloodTest_parallel/FloodTest/t
