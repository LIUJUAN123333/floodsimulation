# ============================================================
# Flood Simulation System local configuration example
# Copy this file to ".env" and adjust values for your own PC.
# Do NOT commit ".env"; it is ignored by Git.
# ============================================================

# ---------------- Frontend / Vite ----------------
# Frontend dev server port.
VITE_FRONTEND_PORT=5174

# Python Flask/Waitress backend address used by Vite proxy /py-api.
VITE_PY_API_TARGET=http://127.0.0.1:5000

# C++ flood simulation backend address used by Vite proxy /api and /external-sim.
VITE_CPP_API_TARGET=http://127.0.0.1:18080

# Optional disaster template shell switches.
VITE_ENABLE_TEMPLATE_SHELL=false
VITE_TEMPLATE_OVERLAY_INTERACTIVE=false
VITE_TEMPLATE_SHOW_LOADING=false
VITE_SYSTEM_TITLE=洪水动态模拟与三维可视化系统

# ---------------- Python backend ----------------
# Python backend listening address and port.
HOST=0.0.0.0
PORT=5000

# Waitress worker threads. Used by backend/serve.py.
WAITRESS_THREADS=8

# Enable Flask debug only for local development. Keep false/empty for demos.
FLASK_DEBUG=false

# Local case metadata/data root. Relative paths are resolved from repository root.
# Team default: repository_root/data_showcase
SHOWCASE_ROOT=data_showcase

# Large showcase frame data CDN/R2 base URL.
# Keep this value if using the shared Cloudflare R2 bucket.
SHOWCASE_CDN_BASE_URL=https://flood-data.disaster.website/showcase

# Runtime upload/output folders. Relative paths are resolved from repository root.
FLOOD_UPLOAD_FOLDER=backend/uploads
FLOOD_OUTPUT_FOLDER=backend/outputs
FLOOD_LAYER_RESOURCE_ROOT=backend/runtime/layers

# Optional workspace used by backend/grid_to_tin.py when no paths are provided.
GTT_WORKSPACE=output/grid_to_tin
